# Copy to .env and fill in.

# MyAnimeList API client ID (required): https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# Umami Cloud website ID (optional): analytics are only loaded in production builds when this is set
UMAMI_WEBSITE_ID=

# Public URL of the site (optional): used for share previews. Not needed on Vercel, which provides it
SITE_URL=
