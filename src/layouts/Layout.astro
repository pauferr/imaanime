---
import { zoneOptions } from '../lib/time';
import { localeUrl, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  subtitle: string;
}
const { locale, title, description, subtitle } = Astro.props;
const t = ui[locale];
const home = localeUrl(locale);
const today = localeUrl(locale, 'today');
const trim = (p: string) => p.replace(/\/$/, '');
const current = (href: string) => (trim(Astro.url.pathname) === trim(href) ? 'page' : undefined);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <div>
        <h1><a href={home}>今 Ima Anime</a></h1>
        <p>{subtitle}</p>
      </div>
      <nav>
        <a href={home} aria-current={current(home)}>{t.nav.season}</a>
        <a href={today} aria-current={current(today)}>{t.nav.today}</a>
      </nav>
      <select id="tz" aria-label={t.tz.label} title={t.tz.title}>
        {zoneOptions(locale).map(({ tz, label }) => <option value={tz}>{label}</option>)}
      </select>
      <label class="switch">
        <span>JP</span>
        <input type="checkbox" id="titles-en" />
        <span>EN</span>
      </label>
    </header>

    <!-- placed before the content: page scripts read #tz and #titles-en already initialized -->
    <script>
      import { city, getTz } from '../lib/time';

      const tz = document.getElementById('tz') as HTMLSelectElement;
      const initial = getTz();
      if (![...tz.options].some((o) => o.value === initial)) {
        tz.add(new Option(`🌐 ${city(initial)}`, initial), 0);
      }
      tz.value = initial;
      tz.addEventListener('change', () => {
        try { localStorage.setItem('tz', tz.value); } catch {}
      });

      // title language (JP/EN) is a separate preference from the UI locale
      const titles = document.getElementById('titles-en') as HTMLInputElement;
      try { titles.checked = localStorage.getItem('titles') === 'en'; } catch {}
      titles.addEventListener('change', () => {
        try { localStorage.setItem('titles', titles.checked ? 'en' : 'jp'); } catch {}
      });
    </script>

    <slot />

    <style is:global>
      /* light-dark(light, dark): follows the system theme via color-scheme */
      :root {
        color-scheme: light dark;
        --bg: light-dark(#f5f5f7, #0f0f12);
        --surface: light-dark(#fff, #1c1c21);
        --text: light-dark(#1d1d1f, #f2f2f5);
        --muted: light-dark(#6e6e73, #9a9aa3);
        --border: light-dark(#d2d2d7, #34343b);
        --accent: #e11d48;
        --ok: light-dark(#16a34a, #22c55e);
        --shadow: 0 2px 8px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.4));
        --shadow-hover: 0 12px 24px light-dark(rgb(0 0 0 / 0.16), rgb(0 0 0 / 0.6));
      }

      /* cross-page transitions (Season ↔ Today): native, no JS; browsers without support just navigate */
      @view-transition { navigation: auto; }
      header { view-transition-name: site-header; }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      header {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 16px 0;
      }
      h1 { margin: 0; font-size: 1.6rem; }
      h1, h2, h3 { text-wrap: balance; }
      h1 a { color: inherit; text-decoration: none; }
      header p { margin: 0.2rem 0 0; color: var(--muted); }

      nav { display: flex; gap: 0.25rem; margin-left: auto; }
      nav a {
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        color: var(--muted);
        font-weight: 600;
        text-decoration: none;
      }
      nav a:hover { color: var(--text); }
      nav a[aria-current='page'] { background: var(--surface); color: var(--accent); box-shadow: var(--shadow); }

      #tz {
        font: inherit;
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
      }
      :is(#tz, nav a):focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
      .switch { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; }
      .switch input {
        appearance: none;
        width: 44px; height: 24px;
        border-radius: 12px;
        background: var(--muted);
        position: relative;
        cursor: pointer;
        transition: background 0.2s;
      }
      .switch input::after {
        content: '';
        position: absolute; top: 3px; left: 3px;
        width: 18px; height: 18px;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.2s;
      }
      .switch input:checked { background: var(--accent); }
      .switch input:checked::after { transform: translateX(20px); }
      .switch input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* ponytail: the switch only toggles CSS via :has(), zero JS to show/hide */
      .en { display: none; }
      body:has(#titles-en:checked) .en { display: inline; }
      body:has(#titles-en:checked) .jp { display: none; }

      /* base card styles; each page defines its own layout */
      .card {
        all: unset;
        background: var(--surface);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s;
      }
      .card:hover, .card:focus-visible { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
      .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .card img { display: block; width: 100%; object-fit: cover; transition: transform 0.3s ease; }
      /* poster cover with a badge on top (score on /, countdown on /today) */
      .cover { position: relative; overflow: hidden; }
      .cover img { aspect-ratio: 45 / 64; }
      .badge {
        position: absolute; left: 8px; bottom: 8px;
        padding: 0.25rem 0.55rem;
        border-radius: 8px;
        background: rgb(0 0 0 / 0.78);
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
      }
      .badge.score { color: #facc15; }
      /* several badges side by side (score + voters on /) */
      .badges { position: absolute; left: 8px; bottom: 8px; display: flex; gap: 4px; }
      .badges .badge { position: static; display: flex; align-items: center; gap: 0.25rem; }
      .badge svg { width: 0.85em; height: 0.85em; }
      .tag {
        position: absolute; left: 8px; top: 8px;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        background: rgb(255 255 255 / 0.9);
        color: #1d1d1f;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .card:hover img { transform: scale(1.05); }

      .score { color: #eab308; font-weight: 700; }
      .empty { grid-column: 1 / -1; text-align: center; color: var(--muted); padding: 3rem 0; }

      @media (max-width: 640px) {
        nav { margin-left: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; }
        ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
      }
    </style>
  </body>
</html>
