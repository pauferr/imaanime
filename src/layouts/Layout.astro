---
import { localeUrl, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  subtitle: string;
}
const { locale, title, description, subtitle } = Astro.props;
const t = ui[locale];
const home = localeUrl(locale);
const today = localeUrl(locale, 'today');
const trim = (p: string) => p.replace(/\/$/, '');
const current = (href: string) => (trim(Astro.url.pathname) === trim(href) ? 'page' : undefined);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <div>
        <h1><a href={home}>今 Ima Anime</a></h1>
        <p>{subtitle}</p>
      </div>
      <nav>
        <a href={home} aria-current={current(home)}>{t.nav.season}</a>
        <a href={today} aria-current={current(today)}>{t.nav.today}</a>
      </nav>
      <button type="button" class="icon-btn" commandfor="settings" command="show-modal" aria-label={t.settings.title} title={t.settings.title}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      </button>
    </header>

    <!-- settings: applied and saved as soon as they change; pages listen for "settings-change" on document -->
    <dialog id="settings" closedby="any" aria-labelledby="settings-title">
      <form method="dialog">
        <h2 id="settings-title">{t.settings.title}</h2>
        <fieldset>
          <legend>{t.titles.label}</legend>
          <div class="segmented">
            <label><input type="radio" name="titles" id="titles-jp" value="jp" checked /><span>{t.titles.romaji}</span></label>
            <label><input type="radio" name="titles" id="titles-en" value="en" /><span>{t.titles.english}</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>{t.settings.clock}</legend>
          <div class="segmented">
            <label><input type="radio" name="clock" value="24" checked /><span>{t.settings.h24}</span></label>
            <label><input type="radio" name="clock" value="12" /><span>{t.settings.h12}</span></label>
          </div>
        </fieldset>
        <label class="field">
          <span>{t.settings.tz}</span>
          <select name="tz" data-auto-label={t.settings.auto('{tz}')}></select>
        </label>
        <button class="done">{t.settings.done}</button>
      </form>
    </dialog>

    <!-- placed before the content: page scripts read #titles-en already initialized -->
    <script>
      import { browserTz, pref } from '../lib/time';

      // Settings: title language (independent of the UI locale), time format and time zone.
      // Pages read them through #titles-en and lib/time.ts (clock(), localTz()).
      const dialog = document.getElementById('settings') as HTMLDialogElement;
      const form = dialog.querySelector('form')!;
      const tz = form.elements.namedItem('tz') as HTMLSelectElement;
      const save = (key: string, value: string) => {
        try {
          value ? localStorage.setItem(key, value) : localStorage.removeItem(key);
        } catch {}
      };

      for (const key of ['titles', 'clock']) {
        const saved = pref(key);
        const input = form.querySelector<HTMLInputElement>(`input[name="${key}"][value="${saved}"]`);
        if (input) input.checked = true;
      }

      // Time zone list: "Automatic" (the browser's zone, default) plus every zone the browser knows,
      // with its current UTC offset. Built on first open, so pages that never open settings don't pay for it.
      function fillZones() {
        if (tz.options.length) return;
        const now = new Date();
        const offset = (zone: string) =>
          new Intl.DateTimeFormat('en', { timeZone: zone, timeZoneName: 'shortOffset' }).formatToParts(now).find((p) => p.type === 'timeZoneName')!.value;
        tz.add(new Option(tz.dataset.autoLabel!.replace('{tz}', browserTz()), ''));
        for (const zone of Intl.supportedValuesOf('timeZone')) tz.add(new Option(`${zone.replaceAll('_', ' ')} (${offset(zone)})`, zone));
        tz.value = pref('tz') ?? '';
      }
      document.querySelector('[commandfor="settings"]')!.addEventListener('click', () => {
        fillZones();
        // commandfor/command opens the dialog natively; older browsers need the call
        if (!('command' in HTMLButtonElement.prototype)) dialog.showModal();
      });

      form.addEventListener('change', () => {
        const data = new FormData(form);
        save('titles', data.get('titles') === 'en' ? 'en' : '');
        save('clock', data.get('clock') === '12' ? '12' : '');
        save('tz', String(data.get('tz') ?? ''));
        document.dispatchEvent(new Event('settings-change'));
      });
    </script>

    <slot />

    <style is:global>
      /* light-dark(light, dark): follows the system theme via color-scheme */
      :root {
        color-scheme: light dark;
        --bg: light-dark(#f5f5f7, #0f0f12);
        --surface: light-dark(#fff, #1c1c21);
        --text: light-dark(#1d1d1f, #f2f2f5);
        --muted: light-dark(#6e6e73, #9a9aa3);
        --border: light-dark(#d2d2d7, #34343b);
        --accent: #e11d48;
        --ok: light-dark(#16a34a, #22c55e);
        --shadow: 0 2px 8px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.4));
        --shadow-hover: 0 12px 24px light-dark(rgb(0 0 0 / 0.16), rgb(0 0 0 / 0.6));
      }

      /* cross-page transitions (Season ↔ Today): native, no JS; browsers without support just navigate */
      @view-transition { navigation: auto; }
      header { view-transition-name: site-header; }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      header {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 16px 0;
      }
      h1 { margin: 0; font-size: 1.6rem; }
      h1, h2, h3 { text-wrap: balance; }
      h1 a { color: inherit; text-decoration: none; }
      header p { margin: 0.2rem 0 0; color: var(--muted); }

      nav { display: flex; gap: 0.25rem; margin-left: auto; }
      nav a {
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        color: var(--muted);
        font-weight: 600;
        text-decoration: none;
      }
      nav a:hover { color: var(--text); }
      nav a[aria-current='page'] { background: var(--surface); color: var(--accent); box-shadow: var(--shadow); }

      nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

      /* segmented control: radios styled as buttons (title language here, New/Continuing tabs on /) */
      .segmented {
        display: flex; gap: 0.25rem; width: fit-content;
        margin: 0; padding: 0.25rem; border: 0; min-width: 0;
        border-radius: 10px; background: var(--surface); box-shadow: var(--shadow);
      }
      .segmented input { position: absolute; opacity: 0; }
      .segmented span {
        display: block;
        padding: 0.4rem 0.9rem;
        border-radius: 8px;
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .segmented small { font-weight: 500; opacity: 0.7; }
      .segmented input:checked + span { background: var(--accent); color: #fff; }
      .segmented input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
      /* header settings button and dialog */
      .icon-btn {
        display: grid; place-items: center;
        width: 38px; height: 38px;
        border: 1px solid var(--border); border-radius: 10px;
        background: var(--surface); color: var(--text);
        cursor: pointer;
      }
      .icon-btn svg { width: 20px; height: 20px; transition: transform 0.3s ease; }
      .icon-btn:hover svg { transform: rotate(45deg); }
      .icon-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      #settings {
        width: min(420px, calc(100vw - 32px));
        padding: 1.25rem;
        border: 0; border-radius: 16px;
        background: var(--bg); color: var(--text);
        box-shadow: 0 24px 64px rgb(0 0 0 / 0.4);
      }
      #settings::backdrop { background: rgb(0 0 0 / 0.5); backdrop-filter: blur(3px); }
      #settings form { display: grid; gap: 1.1rem; }
      #settings h2 { margin: 0; font-size: 1.2rem; }
      #settings legend, #settings .field > span { display: block; margin-bottom: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); }
      #settings fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
      #settings legend { padding: 0; }
      #settings select {
        width: 100%;
        font: inherit;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--border); border-radius: 8px;
        background: var(--surface); color: var(--text);
      }
      #settings .done {
        justify-self: end;
        font: inherit; font-weight: 600;
        padding: 0.5rem 1.1rem;
        border: 0; border-radius: 8px;
        background: var(--accent); color: #fff;
        cursor: pointer;
      }

      /* ponytail: title language only toggles CSS via :has(), zero JS to show/hide */
      .en { display: none; }
      body:has(#titles-en:checked) .en { display: inline; }
      body:has(#titles-en:checked) .jp { display: none; }

      /* base card styles; each page defines its own layout */
      .card {
        all: unset;
        background: var(--surface);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s;
      }
      .card:hover, .card:focus-visible { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
      .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .card img { display: block; width: 100%; object-fit: cover; transition: transform 0.3s ease; }
      /* poster cover with a badge on top (score on /, countdown on /today) */
      .cover { position: relative; overflow: hidden; }
      .cover img { height: auto; aspect-ratio: 45 / 64; } /* height:auto: the img height attribute would otherwise win over aspect-ratio */
      .badge {
        position: absolute; left: 8px; bottom: 8px;
        padding: 0.25rem 0.55rem;
        border-radius: 8px;
        background: rgb(0 0 0 / 0.78);
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
      }
      .badge.score { color: #facc15; }
      /* several badges side by side (score + voters on /) */
      .badges { position: absolute; left: 8px; bottom: 8px; display: flex; gap: 4px; }
      .badges .badge { position: static; display: flex; align-items: center; gap: 0.25rem; }
      .badge svg { width: 0.85em; height: 0.85em; }
      .cover-tags { position: absolute; left: 8px; top: 8px; display: flex; gap: 4px; }
      .tag {
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        background: rgb(255 255 255 / 0.9);
        color: #1d1d1f;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .tag.new { background: var(--accent); color: #fff; }
      .tag.format { background: rgb(0 0 0 / 0.78); color: #fff; }
      .tag.today { background: var(--ok); color: #fff; }
      .card:hover img { transform: scale(1.05); }

      .score { color: #eab308; font-weight: 700; }
      .empty { grid-column: 1 / -1; text-align: center; color: var(--muted); padding: 3rem 0; }

      @media (max-width: 640px) {
        /* logo on its own row; nav and title language share the second one */
        header > div:first-child { flex-basis: 100%; }
        nav { margin-left: 0; }
        .icon-btn { margin-left: auto; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; }
        ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
      }
    </style>
  </body>
</html>
