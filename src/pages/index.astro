---
import Layout from '../layouts/Layout.astro';
import Modal from '../components/Modal.astro';
import { seasonNow, seasonLabel, toJsonScript } from '../lib/jikan';

const season = await seasonNow();
const animes = season.data;
const label = seasonLabel(season);
const score = (s: number | null) => (s == null ? 'N/A' : s.toFixed(2));
const genres = [...new Set(animes.flatMap((a) => a.genres))].sort();
const DAYS: Record<string, string> = {
  Mondays: 'Lunes', Tuesdays: 'Martes', Wednesdays: 'Miércoles', Thursdays: 'Jueves',
  Fridays: 'Viernes', Saturdays: 'Sábado', Sundays: 'Domingo',
};
---

<Layout title={`Ima Anime · ${label}`} description={`Animes en emisión: ${label}`} subtitle={`En emisión · ${label}`}>
  <form class="filters" id="filters" onsubmit="return false">
    <div class="row">
      <input type="search" name="q" placeholder="Buscar por nombre…  ( / )" aria-label="Buscar por nombre" autocomplete="off" />
      <select name="day" aria-label="Día de emisión">
        <option value="">Cualquier día</option>
        {Object.entries(DAYS).map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
      <select name="sort" aria-label="Ordenar">
        <option value="new">Más recientes</option>
        <option value="score">Mejor nota</option>
        <option value="votes">Más populares</option>
        <option value="name">Nombre A–Z</option>
      </select>
    </div>
    <fieldset class="chips">
      <legend>Géneros</legend>
      {genres.map((g) => (
        <label><input type="checkbox" name="genre" value={g} /><span>{g}</span></label>
      ))}
    </fieldset>
    <p class="status">
      <span id="count"></span>
      <button type="reset" id="clear">Limpiar filtros</button>
    </p>
  </form>

  <main class="grid">
    {animes.map((a, i) => (
      <button class="card" data-i={i} aria-haspopup="dialog">
        <img src={a.img} alt="" loading="lazy" width="450" height="640" />
        <div class="body">
          <h2>
            <span class="jp">{a.title}</span>
            <span class="en">{a.titleEn ?? a.title}</span>
          </h2>
          <p class="meta-line">
            <span class="score">★ {score(a.score)}</span>
            <span class="when">{DAYS[a.day ?? ''] ?? '?'}</span>
            <span>{a.episodes ?? '?'} eps</span>
          </p>
          <p class="syn">{a.synopsis}</p>
        </div>
      </button>
    ))}
    <p class="empty" hidden>Ningún anime coincide con los filtros.</p>
  </main>

  <Modal />

  <script type="application/json" id="animes" set:html={toJsonScript(animes)} />

  <script>
    import type { Anime } from '../lib/jikan';
    import { currentTz, localSlot } from '../lib/time';
    import { openModal } from '../lib/modal';

    const animes: Anime[] = JSON.parse(document.getElementById('animes')!.textContent!);
    const toggle = document.getElementById('lang-en') as HTMLInputElement;
    const tzSelect = document.getElementById('tz') as HTMLSelectElement;

    // --- filtros ---
    const form = document.getElementById('filters') as HTMLFormElement;
    const grid = document.querySelector('.grid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const anime = (c: HTMLElement) => animes[Number(c.dataset.i)];
    // minúsculas y sin acentos, para buscar "kimetsu" y encontrar "Kimétsu"
    const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const names = animes.map((a) => norm(`${a.title} ${a.titleEn ?? ''}`));
    const shownName = (c: HTMLElement) => {
      const a = anime(c);
      return toggle.checked ? a.titleEn ?? a.title : a.title;
    };

    function apply() {
      const f = new FormData(form);
      const q = norm(String(f.get('q')).trim());
      const day = f.get('day');
      const picked = f.getAll('genre') as string[];
      const sort = f.get('sort') as 'new' | 'score' | 'votes' | 'name';
      let n = 0;
      for (const c of cards) {
        const a = anime(c);
        // ponytail: géneros con lógica Y (debe tener todos los marcados)
        const ok = (!q || names[Number(c.dataset.i)].includes(q)) && (!day || c.dataset.day === day) && picked.every((p) => a.genres.includes(p));
        c.hidden = !ok;
        n += +ok;
      }
      type C = HTMLElement;
      const by = {
        new: (x: C, y: C) => (anime(y).from ?? '').localeCompare(anime(x).from ?? ''), // ISO: ordena bien como texto; sin fecha al final
        score: (x: C, y: C) => (anime(y).score ?? 0) - (anime(x).score ?? 0),
        votes: (x: C, y: C) => (anime(y).votes ?? 0) - (anime(x).votes ?? 0),
        name: (x: C, y: C) => shownName(x).localeCompare(shownName(y), 'es'),
      }[sort];
      grid.prepend(...cards.sort(by));
      document.getElementById('count')!.textContent = `${n} de ${cards.length} animes`;
      grid.querySelector<HTMLElement>('.empty')!.hidden = n > 0;
      document.getElementById('clear')!.hidden = !q && !day && !picked.length;
      // estado en la URL: compartible y sobrevive a recargar
      const params = new URLSearchParams(
        [...f].filter(([k, v]) => v && !(k === 'sort' && v === 'new')) as [string, string][]
      );
      history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    }

    // restaurar filtros desde la URL
    const params = new URLSearchParams(location.search);
    for (const el of form.querySelectorAll<HTMLInputElement>('[name]'))
      el.type === 'checkbox' ? (el.checked = params.getAll(el.name).includes(el.value)) : (el.value = params.get(el.name) ?? el.value);

    // horarios y día del filtro en la zona horaria elegida
    function renderTz() {
      for (const c of cards) {
        const slot = localSlot(anime(c), currentTz());
        c.dataset.day = slot?.day ?? '';
        c.querySelector('.when')!.textContent = slot?.short ?? '?';
      }
      apply();
    }
    tzSelect.addEventListener('change', renderTz);
    toggle.addEventListener('change', apply); // el orden A–Z depende del idioma
    form.addEventListener('input', apply);
    form.addEventListener('reset', () => setTimeout(apply)); // reset limpia después del evento
    renderTz();

    // "/" enfoca el buscador
    const modal = document.getElementById('modal') as HTMLDialogElement;
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as HTMLElement).closest('input, select, textarea') && !modal.open) {
        e.preventDefault();
        (form.elements.namedItem('q') as HTMLInputElement).focus();
      }
    });

    grid.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      if (card) openModal(anime(card));
    });
  </script>

  <style>
    /* --- filtros --- */
    .filters {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 16px 0;
    }
    .filters .row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .filters input[type='search'], .filters select {
      font: inherit;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      color: var(--text);
    }
    .filters input[type='search'] { flex: 1 1 240px; min-width: 0; }
    .filters :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; border: 0; padding: 0; margin: 0.75rem 0 0; }
    .chips legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .chips input { position: absolute; opacity: 0; }
    .chips span {
      display: block;
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s, color 0.15s;
    }
    .chips span:hover { border-color: var(--accent); }
    .chips input:checked + span { background: var(--accent); border-color: var(--accent); color: #fff; }
    .chips input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    .status { display: flex; align-items: center; gap: 1rem; margin: 0.75rem 0 1rem; color: var(--muted); font-size: 0.9rem; }
    #clear { font: inherit; border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0; }

    /* --- cards (horizontales: portada a la izquierda) --- */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px 3rem;
    }
    .card { display: grid; grid-template-columns: 105px 1fr; height: 150px; }
    .card img { height: 100%; }
    .body { padding: 0.7rem 0.85rem; min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
    .body h2 {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .meta-line { display: flex; gap: 0.6rem; margin: 0; font-size: 0.78rem; color: var(--muted); }
    .syn {
      margin: 0;
      font-size: 0.83rem;
      color: var(--muted);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
      .card { grid-template-columns: 90px 1fr; height: 130px; }
      .syn { -webkit-line-clamp: 2; }
      .filters select { flex: 1; }
    }
  </style>
</Layout>
