---
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import { seasonNow, toJsonScript } from '../../lib/mal';
import { WEEK, weekdayName } from '../../lib/time';
import { localeOf, localePaths, seasonLabel, ui } from '../../i18n';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.params.locale);
const t = ui[locale];
const season = await seasonNow();
const animes = season.data;
const label = seasonLabel(t, season);
const score = (s: number | null) => (s == null ? 'N/A' : s.toFixed(2));
const compact = new Intl.NumberFormat(locale, { notation: 'compact' }); // 10426 → "10K"
const days = [...WEEK.slice(1), WEEK[0]]; // Monday first

// most common genres first: the long tail (many with 1–2 shows) ends up at the bottom of the panel
const genreCount = new Map<string, number>();
for (const g of animes.flatMap((a) => a.genres)) genreCount.set(g, (genreCount.get(g) ?? 0) + 1);
const genres = [...genreCount.keys()].sort((a, b) => genreCount.get(b)! - genreCount.get(a)! || a.localeCompare(b));

// release formats present this season, most common first (TV series, ONA, movies…)
const formatCount = new Map<string, number>();
for (const a of animes) formatCount.set(a.format, (formatCount.get(a.format) ?? 0) + 1);
const formats = [...formatCount.keys()].sort((a, b) => formatCount.get(b)! - formatCount.get(a)!);

const newCount = animes.filter((a) => a.isNew).length;
const tabs = [
  ['new', t.index.tabs.new, newCount],
  ['continuing', t.index.tabs.continuing, animes.length - newCount],
  ['all', t.index.tabs.all, animes.length],
] as const;
---

<Layout locale={locale} title={`Ima Anime · ${label}`} description={t.index.description(label)} subtitle={t.index.subtitle(label)}>
  <form class="filters" id="filters" onsubmit="return false">
    <fieldset class="segmented">
      <legend class="sr-only">{t.index.tabs.label}</legend>
      {tabs.map(([value, name, n]) => (
        <label>
          <input type="radio" name="show" value={value} checked={value === 'new'} />
          <span>{name} <small>{n}</small></span>
        </label>
      ))}
    </fieldset>

    <div class="toolbar">
      <input type="search" name="q" placeholder={t.index.search} aria-label={t.index.searchLabel} autocomplete="off" />
      <select name="sort" aria-label={t.index.sort}>
        <option value="new">{t.index.sortNew}</option>
        <option value="score">{t.index.sortScore}</option>
        <option value="votes">{t.index.sortVotes}</option>
        <option value="name">{t.index.sortName}</option>
      </select>
      <button type="button" class="filters-btn" popovertarget="filters-panel">
        {t.index.filters}<span id="active" hidden></span>
      </button>
    </div>

    <!-- native popover: closes on outside click and Esc; anchored under the button where CSS anchor positioning exists -->
    <div id="filters-panel" popover>
      <fieldset class="chips">
        <legend>{t.index.day}</legend>
        <label><input type="radio" name="day" value="" checked /><span>{t.index.anyDay}</span></label>
        {days.map((d) => <label><input type="radio" name="day" value={d} /><span>{weekdayName(d, locale, 'short')}</span></label>)}
      </fieldset>
      <fieldset class="chips">
        <legend>{t.index.type}</legend>
        {formats.map((f) => <label><input type="checkbox" name="type" value={f} /><span>{t.formats.name[f] ?? f}</span></label>)}
      </fieldset>
      <fieldset class="chips">
        <legend>{t.index.genres}</legend>
        {genres.map((g) => <label><input type="checkbox" name="genre" value={g} /><span>{g}</span></label>)}
      </fieldset>
      <button type="button" id="clear">{t.index.clear}</button>
    </div>

    <p class="status" id="count" hidden></p>
  </form>

  <!-- icon defined once, reused by every card through <use> -->
  <svg hidden>
    <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </symbol>
  </svg>

  <main class="grid">
    {animes.map((a, i) => (
      <button class="card" data-i={i} aria-haspopup="dialog">
        <div class="cover">
          <img src={a.img} alt="" loading="lazy" width="450" height="640" />
          <div class="badges">
            <span class="badge score">★ {score(a.score)}</span>
            {a.score != null && a.votes && (
              <span class="badge" title={t.index.voters(a.votes.toLocaleString(locale))}>
                <svg aria-hidden="true"><use href="#i-users" /></svg>{compact.format(a.votes)}
              </span>
            )}
          </div>
          <div class="cover-tags">
            {a.isNew ? <span class="tag new">{t.isNew}</span> : <span class="tag">{t.continuing}</span>}
            {t.formats.tag[a.format] && <span class="tag format">{t.formats.tag[a.format]}</span>}
          </div>
        </div>
        <h2>
          <span class="jp">{a.title}</span>
          <span class="en">{a.titleEn ?? a.title}</span>
        </h2>
        <p class="when">{a.day ? weekdayName(a.day, locale) : ''}</p>
      </button>
    ))}
    <p class="empty" hidden>{t.index.empty}</p>
  </main>

  <Modal t={t.modal} />

  <script type="application/json" id="animes" set:html={toJsonScript(animes)} />

  <script>
    import type { Anime } from '../../lib/mal';
    import { localSlot, localTz } from '../../lib/time';
    import { openModal } from '../../lib/modal';
    import { pageLocale, ui } from '../../i18n';

    const locale = pageLocale();
    const t = ui[locale];

    const animes: Anime[] = JSON.parse(document.getElementById('animes')!.textContent!);
    const toggle = document.getElementById('titles-en') as HTMLInputElement;

    // --- filters ---
    const form = document.getElementById('filters') as HTMLFormElement;
    const grid = document.querySelector('.grid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const anime = (c: HTMLElement) => animes[Number(c.dataset.i)];
    // lowercase without diacritics, so "kimetsu" matches "Kimétsu"
    const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const names = animes.map((a) => norm(`${a.title} ${a.titleEn ?? ''}`));
    const shownName = (c: HTMLElement) => {
      const a = anime(c);
      return toggle.checked ? a.titleEn ?? a.title : a.title;
    };
    // defaults are left out of the URL
    const DEFAULTS: Record<string, string> = { show: 'new', sort: 'new' };

    function apply() {
      const f = new FormData(form);
      const show = f.get('show');
      const q = norm(String(f.get('q')).trim());
      const day = f.get('day');
      const picked = f.getAll('genre') as string[];
      const types = f.getAll('type') as string[];
      const sort = f.get('sort') as 'new' | 'score' | 'votes' | 'name';
      // searching looks across every tab: "one piece" from the New tab should still find it (cards carry New/Continuing tags)
      const inTab = (a: Anime) => !!q || show === 'all' || (show === 'new') === a.isNew;
      let n = 0;
      for (const c of cards) {
        const a = anime(c);
        const ok =
          inTab(a) &&
          (!q || names[Number(c.dataset.i)].includes(q)) &&
          (!day || c.dataset.day === day) &&
          (!types.length || types.includes(a.format)) && // types: OR (a show has one format)
          picked.every((p) => a.genres.includes(p)); // ponytail: genres use AND logic (must have every selected one)
        c.hidden = !ok;
        n += +ok;
      }
      type C = HTMLElement;
      // "Newest": premiered shows newest first, then upcoming ones soonest first, then those without a date.
      // ISO dates compare correctly as text, also partial ones ("2026-10").
      const today = new Date().toISOString().slice(0, 10);
      const group = (from: string | null) => (!from ? 2 : from.slice(0, 10) <= today ? 0 : 1);
      const byPremiere = (x: C, y: C) => {
        const a = anime(x).from, b = anime(y).from;
        return group(a) - group(b) || (group(a) === 0 ? b!.localeCompare(a!) : (a ?? '').localeCompare(b ?? ''));
      };
      const by = {
        new: byPremiere,
        score: (x: C, y: C) => (anime(y).score ?? 0) - (anime(x).score ?? 0),
        votes: (x: C, y: C) => (anime(y).votes ?? 0) - (anime(x).votes ?? 0),
        name: (x: C, y: C) => shownName(x).localeCompare(shownName(y), locale),
      }[sort];
      grid.prepend(...cards.sort(by));

      // the tabs already show totals: only report a count while narrowing down
      const active = (day ? 1 : 0) + types.length + picked.length;
      const status = document.getElementById('count')!;
      status.hidden = !q && !active;
      status.textContent = t.index.count(n, cards.filter((c) => inTab(anime(c))).length);
      const badge = document.getElementById('active')!;
      badge.hidden = !active;
      badge.textContent = String(active);
      grid.querySelector<HTMLElement>('.empty')!.hidden = n > 0;

      // state lives in the URL: shareable and survives reloads
      const params = new URLSearchParams([...f].filter(([k, v]) => v && DEFAULTS[k] !== v) as [string, string][]);
      history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    }

    // restore filters from the URL; radios keep their default when the URL doesn't mention them
    const params = new URLSearchParams(location.search);
    for (const el of form.querySelectorAll<HTMLInputElement>('[name]')) {
      if (el.type === 'checkbox') el.checked = params.getAll(el.name).includes(el.value);
      else if (el.type === 'radio') el.checked = (params.get(el.name) ?? DEFAULTS[el.name] ?? '') === el.value;
      else el.value = params.get(el.name) ?? el.value;
    }

    // "Clear filters" only clears the panel (day and genres); the tab, search and sort stay
    document.getElementById('clear')!.addEventListener('click', () => {
      for (const el of form.querySelectorAll<HTMLInputElement>('#filters-panel input')) el.checked = el.value === '';
      apply();
    });

    // air times and the day filter follow the user's time zone
    function renderTz() {
      for (const c of cards) {
        const slot = localSlot(anime(c), localTz(), locale);
        c.dataset.day = slot?.day ?? '';
        c.querySelector('.when')!.textContent = slot?.short ?? ''; // no schedule on MAL: show nothing rather than "?"
      }
      apply();
    }
    document.addEventListener('titles-change', apply); // A–Z order depends on the title language
    form.addEventListener('input', apply);
    renderTz();

    // "/" focuses the search box
    const modal = document.getElementById('modal') as HTMLDialogElement;
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as HTMLElement).closest('input, select, textarea') && !modal.open) {
        e.preventDefault();
        (form.elements.namedItem('q') as HTMLInputElement).focus();
      }
    });

    grid.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      if (card) openModal(anime(card), card.querySelector('img')!);
    });
  </script>

  <style>
    .filters {
      display: grid;
      gap: 0.75rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.25rem 16px 1rem;
    }
    fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* --- toolbar --- */
    .toolbar { display: flex; gap: 0.5rem; }
    .toolbar input, .toolbar select, .filters-btn {
      font: inherit;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      color: var(--text);
    }
    .toolbar input { flex: 1; min-width: 0; }
    .filters-btn { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-weight: 600; anchor-name: --filters; }
    #active {
      min-width: 1.4em;
      padding: 0 0.35em;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-size: 0.8rem;
      text-align: center;
    }

    /* --- filters panel (popover) --- */
    #filters-panel {
      width: min(560px, calc(100vw - 32px));
      max-height: min(70vh, 560px);
      overflow-y: auto;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--surface);
      color: var(--text);
      box-shadow: var(--shadow-hover);
    }
    @supports (anchor-name: --a) {
      @media (min-width: 641px) {
        #filters-panel { position-anchor: --filters; inset: auto; top: anchor(bottom); right: anchor(right); margin: 0.5rem 0 0; }
      }
    }
    #filters-panel:popover-open { display: grid; gap: 1rem; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .chips legend { width: 100%; margin-bottom: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); }
    .chips input { position: absolute; opacity: 0; }
    .chips span {
      display: block;
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s, color 0.15s;
    }
    .chips span:hover { border-color: var(--accent); }
    .chips input:checked + span { background: var(--accent); border-color: var(--accent); color: #fff; }
    .chips input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    #clear { justify-self: start; font: inherit; border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0; }
    .status { margin: 0; color: var(--muted); font-size: 0.9rem; }

    /* --- poster grid --- */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1.25rem 1rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px 3rem;
    }
    .card { display: flex; flex-direction: column; }
    .card h2 {
      margin: 0.55rem 0.65rem 0.15rem;
      font-size: 0.9rem;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .when { margin: 0 0.65rem 0.65rem; font-size: 0.8rem; color: var(--muted); }

    @media (max-width: 640px) {
      .grid { grid-template-columns: repeat(2, 1fr); gap: 1rem 0.75rem; }
      .toolbar { flex-wrap: wrap; }
      .toolbar input { flex-basis: 100%; }
      .toolbar select { flex: 1; }
    }
  </style>
</Layout>
