---
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import { seasonNow, toJsonScript } from '../../lib/mal';
import { WEEK, weekdayName } from '../../lib/time';
import { localeOf, localePaths, seasonLabel, ui } from '../../i18n';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.params.locale);
const t = ui[locale];
const season = await seasonNow();
const animes = season.data;
const label = seasonLabel(t, season);
const score = (s: number | null) => (s == null ? 'N/A' : s.toFixed(2));
const genres = [...new Set(animes.flatMap((a) => a.genres))].sort();
const days = [...WEEK.slice(1), WEEK[0]]; // Monday first
---

<Layout locale={locale} title={`Ima Anime · ${label}`} description={t.index.description(label)} subtitle={t.index.subtitle(label)}>
  <form class="filters" id="filters" onsubmit="return false">
    <div class="row">
      <input type="search" name="q" placeholder={t.index.search} aria-label={t.index.searchLabel} autocomplete="off" />
      <select name="day" aria-label={t.index.day}>
        <option value="">{t.index.anyDay}</option>
        {days.map((d) => <option value={d}>{weekdayName(d, locale)}</option>)}
      </select>
      <select name="sort" aria-label={t.index.sort}>
        <option value="new">{t.index.sortNew}</option>
        <option value="score">{t.index.sortScore}</option>
        <option value="votes">{t.index.sortVotes}</option>
        <option value="name">{t.index.sortName}</option>
      </select>
    </div>
    <fieldset class="chips">
      <legend>{t.index.genres}</legend>
      {genres.map((g) => (
        <label><input type="checkbox" name="genre" value={g} /><span>{g}</span></label>
      ))}
    </fieldset>
    <p class="status">
      <span id="count"></span>
      <button type="reset" id="clear">{t.index.clear}</button>
    </p>
  </form>

  <main class="grid">
    {animes.map((a, i) => (
      <button class="card" data-i={i} aria-haspopup="dialog">
        <img src={a.img} alt="" loading="lazy" width="450" height="640" />
        <div class="body">
          <h2>
            <span class="jp">{a.title}</span>
            <span class="en">{a.titleEn ?? a.title}</span>
          </h2>
          <p class="meta-line">
            <span class="score">★ {score(a.score)}</span>
            <span class="when">{a.day ? weekdayName(a.day, locale) : '?'}</span>
            <span>{t.index.eps(a.episodes ?? '?')}</span>
          </p>
          <p class="syn">{a.synopsis ?? t.noSynopsis}</p>
        </div>
      </button>
    ))}
    <p class="empty" hidden>{t.index.empty}</p>
  </main>

  <Modal t={t.modal} />

  <script type="application/json" id="animes" set:html={toJsonScript(animes)} />

  <script>
    import type { Anime } from '../../lib/mal';
    import { currentTz, localSlot } from '../../lib/time';
    import { openModal } from '../../lib/modal';
    import { pageLocale, ui } from '../../i18n';

    const locale = pageLocale();
    const t = ui[locale];

    const animes: Anime[] = JSON.parse(document.getElementById('animes')!.textContent!);
    const toggle = document.getElementById('titles-en') as HTMLInputElement;
    const tzSelect = document.getElementById('tz') as HTMLSelectElement;

    // --- filters ---
    const form = document.getElementById('filters') as HTMLFormElement;
    const grid = document.querySelector('.grid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const anime = (c: HTMLElement) => animes[Number(c.dataset.i)];
    // lowercase without diacritics, so "kimetsu" matches "Kimétsu"
    const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const names = animes.map((a) => norm(`${a.title} ${a.titleEn ?? ''}`));
    const shownName = (c: HTMLElement) => {
      const a = anime(c);
      return toggle.checked ? a.titleEn ?? a.title : a.title;
    };

    function apply() {
      const f = new FormData(form);
      const q = norm(String(f.get('q')).trim());
      const day = f.get('day');
      const picked = f.getAll('genre') as string[];
      const sort = f.get('sort') as 'new' | 'score' | 'votes' | 'name';
      let n = 0;
      for (const c of cards) {
        const a = anime(c);
        // ponytail: genres use AND logic (must have every selected one)
        const ok = (!q || names[Number(c.dataset.i)].includes(q)) && (!day || c.dataset.day === day) && picked.every((p) => a.genres.includes(p));
        c.hidden = !ok;
        n += +ok;
      }
      type C = HTMLElement;
      const by = {
        new: (x: C, y: C) => (anime(y).from ?? '').localeCompare(anime(x).from ?? ''), // ISO strings sort correctly as text; missing dates go last
        score: (x: C, y: C) => (anime(y).score ?? 0) - (anime(x).score ?? 0),
        votes: (x: C, y: C) => (anime(y).votes ?? 0) - (anime(x).votes ?? 0),
        name: (x: C, y: C) => shownName(x).localeCompare(shownName(y), locale),
      }[sort];
      grid.prepend(...cards.sort(by));
      document.getElementById('count')!.textContent = t.index.count(n, cards.length);
      grid.querySelector<HTMLElement>('.empty')!.hidden = n > 0;
      document.getElementById('clear')!.hidden = !q && !day && !picked.length;
      // state lives in the URL: shareable and survives reloads
      const params = new URLSearchParams(
        [...f].filter(([k, v]) => v && !(k === 'sort' && v === 'new')) as [string, string][]
      );
      history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    }

    // restore filters from the URL
    const params = new URLSearchParams(location.search);
    for (const el of form.querySelectorAll<HTMLInputElement>('[name]'))
      el.type === 'checkbox' ? (el.checked = params.getAll(el.name).includes(el.value)) : (el.value = params.get(el.name) ?? el.value);

    // air times and the day filter follow the selected time zone
    function renderTz() {
      for (const c of cards) {
        const slot = localSlot(anime(c), currentTz(), locale);
        c.dataset.day = slot?.day ?? '';
        c.querySelector('.when')!.textContent = slot?.short ?? '?';
      }
      apply();
    }
    tzSelect.addEventListener('change', renderTz);
    toggle.addEventListener('change', apply); // A–Z order depends on the title language
    form.addEventListener('input', apply);
    form.addEventListener('reset', () => setTimeout(apply)); // reset clears the fields after the event fires
    renderTz();

    // "/" focuses the search box
    const modal = document.getElementById('modal') as HTMLDialogElement;
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as HTMLElement).closest('input, select, textarea') && !modal.open) {
        e.preventDefault();
        (form.elements.namedItem('q') as HTMLInputElement).focus();
      }
    });

    grid.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      if (card) openModal(anime(card), card.querySelector('img')!);
    });
  </script>

  <style>
    /* --- filters --- */
    .filters {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 16px 0;
    }
    .filters .row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .filters input[type='search'], .filters select {
      font: inherit;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      color: var(--text);
    }
    .filters input[type='search'] { flex: 1 1 240px; min-width: 0; }
    .filters :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; border: 0; padding: 0; margin: 0.75rem 0 0; }
    .chips legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .chips input { position: absolute; opacity: 0; }
    .chips span {
      display: block;
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s, color 0.15s;
    }
    .chips span:hover { border-color: var(--accent); }
    .chips input:checked + span { background: var(--accent); border-color: var(--accent); color: #fff; }
    .chips input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    .status { display: flex; align-items: center; gap: 1rem; margin: 0.75rem 0 1rem; color: var(--muted); font-size: 0.9rem; }
    #clear { font: inherit; border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0; }

    /* --- cards (horizontal: cover on the left) --- */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px 3rem;
    }
    .card { display: grid; grid-template-columns: 105px 1fr; height: 150px; }
    .card img { height: 100%; }
    .body { padding: 0.7rem 0.85rem; min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
    .body h2 {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .meta-line { display: flex; gap: 0.6rem; margin: 0; font-size: 0.78rem; color: var(--muted); }
    .syn {
      margin: 0;
      font-size: 0.83rem;
      color: var(--muted);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
      .card { grid-template-columns: 90px 1fr; height: 130px; }
      .syn { -webkit-line-clamp: 2; }
      .filters select { flex: 1; }
    }
  </style>
</Layout>
