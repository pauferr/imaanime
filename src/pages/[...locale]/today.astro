---
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import { seasonNow, toJsonScript } from '../../lib/mal';
import { localeOf, localePaths, seasonLabel, ui } from '../../i18n';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.params.locale);
const t = ui[locale];
const season = await seasonNow();
// What airs "today" depends on the user's time zone: render everything and let the client filter
const animes = season.data.filter((a) => (a.day && a.time) || a.airings?.length);
const label = seasonLabel(t, season);
---

<Layout locale={locale} title={`${t.today.title} · Ima Anime`} description={t.today.description(label)} subtitle={t.today.subtitle(label)}>
  <div class="today-head">
    <h2 id="today-title">{t.today.title}</h2>
    <input type="search" id="q" placeholder={t.index.search} aria-label={t.index.searchLabel} autocomplete="off" />
  </div>

  <!-- two sections: what's next (soonest first) and what already aired (most recent first); cards move between them -->
  <main class="today-main">
    <section class="day-section" id="upnext" hidden>
      <h3>{t.today.upNext} <small></small></h3>
      <div class="today">
    {animes.map((a, i) => (
      <button class="card" data-i={i} aria-haspopup="dialog" hidden>
        <div class="cover">
          <img src={a.img} alt="" loading="lazy" width="450" height="640" />
          <div class="badges">
            <span class="badge countdown"></span>
            <span class="badge ep" hidden></span>
          </div>
          <div class="cover-tags">
            {a.isNew ? <span class="tag new">{t.isNew}</span> : <span class="tag">{t.continuing}</span>}
            {t.formats.tag[a.format] && <span class="tag format">{t.formats.tag[a.format]}</span>}
          </div>
        </div>
        <div class="tbody">
          <h3>
            <span class="jp">{a.title}</span>
            <span class="en">{a.titleEn ?? a.title}</span>
          </h3>
          <p class="tmeta">
            <span class="time"></span>
            <span class="score">★ {a.score == null ? 'N/A' : a.score.toFixed(2)}</span>
          </p>
          <p class="tsyn">{a.synopsis ?? t.noSynopsis}</p>
        </div>
      </button>
    ))}
      </div>
    </section>
    <section class="day-section" id="aired" hidden>
      <h3>{t.today.airedToday} <small></small></h3>
      <div class="today"></div>
    </section>
    <p class="empty" hidden>{t.today.empty}</p>
  </main>

  <Modal t={t.modal} />

  <script type="application/json" id="animes" set:html={toJsonScript(animes)} />

  <script>
    import type { Anime } from '../../lib/mal';
    import { localTz, timeIn, todaysEpisode } from '../../lib/time';
    import { episodeLabel, openModal } from '../../lib/modal';
    import { pageLocale, ui } from '../../i18n';
    import { track } from '../../lib/track';

    const locale = pageLocale();
    const t = ui[locale].today;

    const animes: Anime[] = JSON.parse(document.getElementById('animes')!.textContent!);
    const list = document.querySelector('.today-main')!;
    const cards = [...list.querySelectorAll<HTMLElement>('.card')];
    const empty = list.querySelector<HTMLElement>('.empty')!;
    const upNext = document.getElementById('upnext')!;
    const airedToday = document.getElementById('aired')!;
    const title = document.getElementById('today-title')!;
    const search = document.getElementById('q') as HTMLInputElement;
    // lowercase without diacritics, same as the search on /
    const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const names = animes.map((a) => norm(`${a.title} ${a.titleEn ?? ''}`));

    const duration = new Intl.DurationFormat(locale, { style: 'narrow' }); // "2h 5m 12s"
    const countdown = (ms: number) => {
      const s = Math.floor(ms / 1000);
      return duration.format({ hours: Math.floor(s / 3600), minutes: Math.floor((s % 3600) / 60), seconds: s % 60 });
    };

    let order = '';
    // ponytail: recomputes everything every second; there are few cards. This also rolls over at midnight for free.
    function tick() {
      const tz = localTz();
      const now = new Date();
      title.textContent = t.heading(now.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: tz }));

      const q = norm(search.value.trim());
      const shown: { card: HTMLElement; at: number; aired: boolean }[] = [];
      for (const card of cards) {
        const i = Number(card.dataset.i);
        const today = todaysEpisode(animes[i], tz, now);
        const ok = !!today && (!q || names[i].includes(q));
        card.hidden = !ok;
        if (!ok) continue;
        const at = today!.at;
        const ep = card.querySelector<HTMLElement>('.ep')!;
        ep.hidden = today!.ep == null;
        ep.textContent = today!.ep == null ? '' : episodeLabel(animes[i], today!.ep, locale);
        const left = at.getTime() - now.getTime();
        const aired = left <= 0;
        card.classList.toggle('aired', aired);
        card.querySelector('.countdown')!.textContent = aired ? t.aired : `⏱ ${countdown(left)}`;
        card.querySelector('.time')!.textContent = `🕒 ${timeIn(at, tz, locale)}`;
        shown.push({ card, at: at.getTime(), aired });
      }

      // Up next: soonest first. Aired today: most recent first (what you can watch right now is at the top)
      const next = shown.filter((s) => !s.aired).sort((x, y) => x.at - y.at);
      const done = shown.filter((s) => s.aired).sort((x, y) => y.at - x.at);
      const ids = (l: typeof shown) => l.map((s) => s.card.dataset.i).join();
      const key = `${ids(next)}|${ids(done)}`;
      if (key !== order) {
        // only reorder on change: moving nodes every second would break hover
        upNext.querySelector('.today')!.prepend(...next.map((s) => s.card));
        airedToday.querySelector('.today')!.prepend(...done.map((s) => s.card));
        order = key;
      }
      for (const [section, items] of [[upNext, next], [airedToday, done]] as const) {
        section.hidden = !items.length;
        section.querySelector('small')!.textContent = String(items.length);
      }
      empty.hidden = shown.length > 0;
    }

    list.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      if (card) openModal(animes[Number(card.dataset.i)], card.querySelector('img')!);
    });
    search.addEventListener('input', tick);
    // analytics: a search counts once the user stops typing; the query text is never sent
    let searchTimer = 0;
    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      if (search.value.trim()) searchTimer = window.setTimeout(() => track('search', { page: '/today' }), 1500);
    });
    document.addEventListener('settings-change', tick);
    // "/" focuses the search box, as on /
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as HTMLElement).closest('input, select, textarea') && !(document.getElementById('modal') as HTMLDialogElement).open) {
        e.preventDefault();
        search.focus();
      }
    });
    tick();
    setInterval(tick, 1000);
  </script>

  <style>
    .today-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem 1rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 16px 1rem;
    }
    .today-head h2 { margin: 0; font-size: 1.2rem; text-transform: capitalize; }
    #q {
      flex: 0 1 320px;
      min-width: 0;
      font: inherit;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      color: var(--text);
    }
    #q:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .day-section > h3 {
      max-width: 1200px;
      margin: 0.5rem auto 0;
      padding: 0 16px 0.75rem;
      font-size: 0.85rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .day-section > h3 small { margin-left: 0.35rem; font-size: inherit; opacity: 0.7; }
    .today {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 1.25rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px 2rem;
    }
    .card { display: flex; flex-direction: column; }
    .aired .countdown { background: var(--ok); }
    .tbody { padding: 0.75rem 0.9rem 1rem; }
    .tbody h3 { margin: 0 0 0.35rem; font-size: 1rem; line-height: 1.3; }
    .tmeta { display: flex; gap: 0.75rem; margin: 0 0 0.4rem; font-size: 0.85rem; color: var(--muted); }
    .tsyn {
      margin: 0;
      font-size: 0.85rem;
      color: var(--muted);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    @media (max-width: 640px) {
      .today { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
      #q { flex-basis: 100%; }
    }
  </style>
</Layout>
