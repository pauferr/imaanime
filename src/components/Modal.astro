---
import type { Dict } from '../i18n';
const { t } = Astro.props as { t: Dict['modal'] };
---

<!-- Opened with openModal() from src/lib/modal.ts -->
<!-- closedby="any": native light dismiss on outside click (not in Safari yet; Esc and ✕ still work there) -->
<dialog id="modal" closedby="any">
  <form method="dialog"><button class="close" aria-label={t.close}>✕</button></form>
  <img data-f="img" alt="" />
  <div class="info">
    <h2 data-f="title"></h2>
    <p class="alt" data-f="alt"></p>
    <p class="meta">
      <strong data-f="score"></strong> <span data-f="votes"></span>
    </p>
    <ul class="tags" data-f="genres"></ul>
    <p data-f="synopsis"></p>
    <!-- rows wrapped in <div> can be hidden as a whole when there is no data -->
    <dl>
      <dt>{t.format}</dt><dd data-f="format"></dd>
      <dt>{t.episodes}</dt><dd data-f="episodes"></dd>
      <div data-row="next"><dt>{t.next}</dt><dd data-f="next"></dd></div>
      <div data-row="broadcast"><dt>{t.broadcast}</dt><dd data-f="broadcast"></dd></div>
      <dt>{t.aired}</dt><dd data-f="aired"></dd>
      <dt>{t.studio}</dt><dd data-f="studios"></dd>
      <div data-row="prequel"><dt>{t.prequel}</dt><dd><a data-f="prequel" target="_blank" rel="noopener"></a></dd></div>
      <div data-row="sequel"><dt>{t.sequel}</dt><dd><a data-f="sequel" target="_blank" rel="noopener"></a></dd></div>
    </dl>
    <a data-f="url" target="_blank" rel="noopener">{t.viewOnMal}</a>
  </div>
</dialog>

<!-- global: openModal() creates <li> elements in JS, which would not get the scoped-style attribute -->
<style is:global>
  #modal {
    width: min(860px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.4);
  }
  /* open and close animations: @starting-style + allow-discrete keep the dialog rendered while it fades out */
  #modal, #modal::backdrop {
    transition: opacity 0.2s ease, scale 0.2s ease, overlay 0.2s allow-discrete, display 0.2s allow-discrete;
    opacity: 0;
  }
  #modal { scale: 0.96; }
  #modal[open] { display: grid; grid-template-columns: 300px 1fr; opacity: 1; scale: 1; }
  #modal[open]::backdrop { opacity: 1; }
  @starting-style {
    #modal[open], #modal[open]::backdrop { opacity: 0; }
    #modal[open] { scale: 0.96; }
  }
  #modal::backdrop { background: rgb(0 0 0 / 0.6); backdrop-filter: blur(4px); }
  #modal > form { display: contents; } /* ✕ is absolutely positioned; the form must not take a grid cell */
  #modal > img { width: 100%; height: 100%; object-fit: cover; }
  #modal .info { padding: 1.5rem; overflow-y: auto; }
  #modal h2 { margin: 0; font-size: 1.5rem; }
  #modal .alt { margin: 0.2rem 0 0; color: var(--muted); }
  #modal .meta strong { color: #eab308; font-size: 1.2rem; }
  #modal .meta span { color: var(--muted); font-size: 0.85rem; }
  #modal .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; list-style: none; }
  #modal .tags li { padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--bg); font-size: 0.8rem; }
  #modal dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; font-size: 0.9rem; }
  #modal dt { color: var(--muted); }
  #modal dd { margin: 0; }
  #modal dl > div { display: contents; }
  #modal dd a { color: inherit; }
  #modal .info a { color: var(--accent); font-weight: 600; }
  #modal .close {
    position: absolute; top: 10px; right: 10px;
    width: 32px; height: 32px;
    border: 0; border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    #modal[open] { grid-template-columns: 1fr; overflow-y: auto; }
    #modal > img { max-height: 280px; }
  }
</style>
